{
  "name": "cu-wiki-chinese-site",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": { "node": ">=24.0.0" },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "npm run verify && astro build",
    "preview": "astro preview --host 127.0.0.1",
    "check": "astro check",
    "sync": "tsx scripts/sync-releases.ts",
    "verify": "tsx scripts/verify-catalog.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:browser": "playwright test"
  },
  "dependencies": { "astro": "7.4.4" },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@playwright/test": "^1.58.0",
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
