---
import catalogData from '../../../data/releases.json';
import { latestStable, formatSize, formatReleaseDate, type ReleaseCatalog } from '../../lib/catalog';
import { sitePath } from '../site-path';
const release = latestStable(catalogData as ReleaseCatalog);
const asset = release?.assets[0];
const date = formatReleaseDate(release?.publishedAt);
---
<header class="hero shell">
  <p class="hero-kicker">CASUALTIES: UNKNOWN</p>
  <h1>未知伤亡<span>维基中文</span></h1>
  <p class="hero-intro">把数值、机制与心得一起带进游戏。</p>
  <p class="hero-description">基于官方翻译，为物品、建筑、液体、健康面板与生物补充说明。</p>
  <div class="hero-actions">
    {release && asset ? <a class="button primary" href={sitePath(asset.path)} download={asset.name} aria-label={`下载 ${release.tag} ${asset.label || asset.name}`} data-hero-download>下载最新版本 <span aria-hidden="true">↓</span></a> : <a class="button primary" href="#download">查看下载 <span aria-hidden="true">↓</span></a>}
    <a class="button secondary" href="#tutorial">安装教程</a>
  </div>
  <p class="hero-version-info" data-latest-release={release?.tag}>
    {release && <span>最新正式版 <strong>{release.tag}</strong></span>}
    {date && <><span class="meta-divider" aria-hidden="true">·</span><time datetime={release?.publishedAt ?? undefined}>{date}</time></>}
    {asset && <><span class="meta-divider" aria-hidden="true">·</span><span>{formatSize(asset.size)}</span></>}
  </p>
  <p class="hero-footnote">免费分享 · 无需注册</p>
  <nav aria-label="主要导航" class="main-nav">
    <a href="#about">介绍</a>
    <a href="#tutorial">安装</a>
    <a href="#download">下载</a>
    <a href="#credits">贡献者</a>
    <a href="#links">链接</a>
  </nav>
</header>
